        RowBox[{"x", "/", 
         SubscriptBox["c", "c"]}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vpgen", "[", "x_", "]"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["A", "2"], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"\[Omega]", " ", 
        RowBox[{"x", "/", 
         SubscriptBox["c", "p"]}]}], "]"}]}], "+", 
     RowBox[{
      SubscriptBox["B", "2"], " ", 
      RowBox[{"Sin", "[", " ", 
