       RowBox[{"\[Omega]", " ", 
        RowBox[{"x", "/", 
         SubscriptBox["c", "c"]}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vpgen", "[", "x_", "]"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["A", "2"], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"\[Omega]", " ", 
        RowBox[{"x", "/", 
         SubscriptBox["c", "p"]}]}], "]"}]}], "+", 
     RowBox[{
      SubscriptBox["B", "2"], " ", 
      RowBox[{"Sin", "[", " ", 
       RowBox[{"\[Omega]", " ", 
        RowBox[{"x", "/", 
         SubscriptBox["c", "p"]}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vcrgen", "[", "x_", "]"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["A", "3"], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"\[Omega]", " ", 
        RowBox[{"x", "/", 
         SubscriptBox["c", "c"]}]}], "]"}]}], "+", 
     RowBox[{
      SubscriptBox["B", "3"], " ", 
      RowBox[{"Sin", "[", " ", 
       RowBox[{"\[Omega]", " ", 
        RowBox[{"x", "/", 
         SubscriptBox["c", "c"]}]}], "]"}]}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.9537072619306593`*^9, 3.953707379824307*^9}, {
