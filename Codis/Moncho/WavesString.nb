Cell[CellGroupData[{

Cell["\<\
The determinant of the system gives us the dispersion relation. It must be \
zero for the system to have a solution other than A = B = C = 0.\
\>", "Subsubsection",
 CellChangeTimes->{{3.953728771142632*^9, 
  3.953728805109289*^9}},ExpressionUUID->"c2805d4e-e7c1-43d9-8382-\
58a083c2184c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"dr", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"Det", "[", "m", "]"}], "/", "\[Omega]"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"dr", "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{"ExpToTrig", "[", 
      RowBox[{"Det", "[", "m", "]"}], "]"}], "]"}]}], "*)"}]}]}], "Input",
