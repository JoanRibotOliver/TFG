Cell[TextData[{
 "We impose that the velocity and its x-derivative are continuous at ",
 Cell[BoxData[
  RowBox[{"x", "=", 
   SubscriptBox["x", "p"]}]],
  CellChangeTimes->{{3.9537072619306593`*^9, 3.953707379824307*^9}, {
   3.9537121112803307`*^9, 3.953712116122335*^9}, {3.953716686703291*^9, 
   3.953716687004586*^9}, {3.953717957751033*^9, 3.9537179966052027`*^9}, {
   3.953722146240797*^9, 3.953722166380665*^9}},ExpressionUUID->
  "f0e72e67-fe66-4f87-8645-a9f283466b20"],
 " and that it vanishes at ",
 Cell[BoxData[
  RowBox[{"x", "=", 
   SubscriptBox["x", "c"]}]],
  CellChangeTimes->{{3.9537072619306593`*^9, 3.953707379824307*^9}, {
   3.9537121112803307`*^9, 3.953712116122335*^9}, {3.953716686703291*^9, 
   3.953716687004586*^9}, {3.953717957751033*^9, 3.9537179966052027`*^9}, {
   3.953722146240797*^9, 3.953722166380665*^9}},ExpressionUUID->
  "3e88e2a5-b726-4ec9-b43e-65d70d9e19c4"],
 ". Because of parity, the velocity automatically vanishes at ",
 Cell[BoxData[
  RowBox[{"x", "=", 
   RowBox[{"-", 
    SubscriptBox["x", "c"]}]}]],
  CellChangeTimes->{{3.9537072619306593`*^9, 3.953707379824307*^9}, {
   3.9537121112803307`*^9, 3.953712116122335*^9}, {3.953716686703291*^9, 
