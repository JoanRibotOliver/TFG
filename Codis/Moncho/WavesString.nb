Cell[CellGroupData[{

Cell["Solutions in the three regions for the selected parity.", \
"Subsubsection",
 CellChangeTimes->{{3.9537286279466667`*^9, 
  3.953728638750592*^9}},ExpressionUUID->"aebea39a-2e74-4741-a506-\
bfd18e3ec7dc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"EvenParity", "=", "False"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{"EvenParity", ",", "\[IndentingNewLine]", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Print", "[", "\"\<v[x] is even\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vcl", "[", "x_", "]"}], "=", 
      RowBox[{
       RowBox[{"vclgen", "[", "x", "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubscriptBox["A", "1"], "->", "A"}], ",", 
         RowBox[{
          SubscriptBox["B", "1"], "->", 
          RowBox[{"-", "B"}]}]}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vp", "[", "x_", "]"}], "=", 
      RowBox[{"C", " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"\[Omega]", " ", 
         RowBox[{"x", "/", 
          SubscriptBox["c", "p"]}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vcr", "[", "x_", "]"}], "=", 
      RowBox[{
       RowBox[{"vcrgen", "[", "x", "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubscriptBox["A", "3"], "->", "A"}], ",", 
         RowBox[{
          SubscriptBox["B", "3"], "->", "B"}]}], "}"}]}]}], ";"}], 
    "\[IndentingNewLine]", ")"}], ",", "\[IndentingNewLine]", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Print", "[", "\"\<v[x] is odd\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vcl", "[", "x_", "]"}], "=", 
      RowBox[{
       RowBox[{"vclgen", "[", "x", "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubscriptBox["A", "1"], "->", 
          RowBox[{"-", "A"}]}], ",", 
         RowBox[{
          SubscriptBox["B", "1"], "->", "B"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vp", "[", "x_", "]"}], "=", 
      RowBox[{"C", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"\[Omega]", " ", 
         RowBox[{"x", "/", 
          SubscriptBox["c", "p"]}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vcr", "[", "x_", "]"}], "=", 
      RowBox[{
       RowBox[{"vcrgen", "[", "x", "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubscriptBox["A", "3"], "->", "A"}], ",", 
         RowBox[{
          SubscriptBox["B", "3"], "->", "B"}]}], "}"}]}]}], ";"}], 
    "\[IndentingNewLine]", ")"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"vcl", "[", "x", "]"}], "\[IndentingNewLine]", 
 RowBox[{"vp", "[", "x", "]"}], "\[IndentingNewLine]", 
 RowBox[{"vcr", "[", "x", "]"}]}], "Input",
