Cell["\<\
One solution to the dispersion relation is computed numerically and the \
corresponding velocity is plotted.\
\>", "Subsubsection",
 CellChangeTimes->{{3.953729017713868*^9, 3.953729050257329*^9}, {
  3.953729088821518*^9, 
  3.953729092063348*^9}},ExpressionUUID->"c79fee65-2496-4df5-8b74-\
d8e8061a2342"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Print", "[", "\"\<Guess value of the frequency:\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"\[Omega]0", "=", "40"}], "\[IndentingNewLine]", 
 RowBox[{"repl\[Omega]", "=", 
  RowBox[{"FindRoot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"dr", "/.", "repl"}], ")"}], "==", "0"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Omega]", ",", "\[Omega]0"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"replAB", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"A", "->", "Asol"}], "/.", "repl"}], "/.", "repl\[Omega]"}], 
    ",", 
    RowBox[{
     RowBox[{
      RowBox[{"B", "->", "Bsol"}], "/.", "repl"}], "/.", "repl\[Omega]"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"v", "[", "x_", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"vcl", "[", "x", "]"}], ",", 
          RowBox[{"x", "<", 
           RowBox[{"-", 
            SubscriptBox["x", "p"]}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"vp", "[", "x", "]"}], ",", 
          RowBox[{
           RowBox[{"Abs", "[", "x", "]"}], "<=", 
           SubscriptBox["x", "p"]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"vcr", "[", "x", "]"}], ",", 
          RowBox[{"x", ">", 
           SubscriptBox["x", "p"]}]}], "}"}]}], "}"}], "]"}], "/.", "repl"}], 
    "/.", "repl\[Omega]"}], "/.", "replAB"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"v", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{
      RowBox[{"-", 
       SubscriptBox["x", "c"]}], "/.", "repl"}], ",", 
     RowBox[{
      SubscriptBox["x", "c"], "/.", "repl"}]}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<v[x]\>\""}], "}"}]}]}], "]"}]}], "Input",
