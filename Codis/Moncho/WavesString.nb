Cell[CellGroupData[{

Cell["\<\
Now, the rank of the system is two, which means that we must impose the value \
of one of the three constants and calculate the other two in terms of the \
first one. We use the second and third equations to get A and B in terms of C.

We also check that this solution satisfies the first equation.\
\>", "Subsubsection",
 CellChangeTimes->{{3.953728818982544*^9, 
  3.95372889467624*^9}},ExpressionUUID->"95f771a2-2550-4946-90d5-\
b25268d49afb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"solAB", "=", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"eqn2", "==", "0"}], ",", 
       RowBox[{"eqn3", "==", "0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"A", ",", "B"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"solAB", "=", 
  RowBox[{"Simplify", "[", "solAB", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", "Asol", "}"}], "=", 
  RowBox[{"A", "/.", "solAB"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", "Bsol", "}"}], "=", 
   RowBox[{"B", "/.", "solAB"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"solABtrig", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"ExpToTrig", "[", "solAB", "]"}], "\[IndentingNewLine]", 
      RowBox[{"{", "Asol", "}"}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"ComplexExpand", "[", 
        RowBox[{"Re", "[", 
         RowBox[{"A", "/.", "solABtrig"}], "]"}], "]"}], 
       "\[IndentingNewLine]", 
       RowBox[{"{", "Bsol", "}"}]}], "=", 
      RowBox[{"ComplexExpand", "[", 
       RowBox[{"Re", "[", 
        RowBox[{"B", "/.", "solABtrig"}], "]"}], "]"}]}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<Equation eqn1 is satisfied:\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{"eqn1", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"A", "->", "Asol"}], ",", 
      RowBox[{"B", "->", "Bsol"}]}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"%", "==", 
  RowBox[{"Expand", "[", 
   RowBox[{"C", " ", 
    SubscriptBox["c", "c"], "dr"}], "]"}]}]}], "Input",
