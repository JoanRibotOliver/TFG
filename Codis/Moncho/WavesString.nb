Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Print", "[", "\"\<Guess value of the frequency:\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"\[Omega]0", "=", "13"}], "\[IndentingNewLine]", 
 RowBox[{"repl\[Omega]", "=", 
  RowBox[{"FindRoot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"dr", "/.", "repl"}], ")"}], "==", "0"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Omega]", ",", "\[Omega]0"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"replAB", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"A", "->", "Asol"}], "/.", "repl"}], "/.", "repl\[Omega]"}], 
    ",", 
    RowBox[{
     RowBox[{
      RowBox[{"B", "->", "Bsol"}], "/.", "repl"}], "/.", "repl\[Omega]"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"v", "[", "x_", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"vcl", "[", "x", "]"}], ",", 
          RowBox[{"x", "<", 
           RowBox[{"-", 
            SubscriptBox["x", "p"]}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"vp", "[", "x", "]"}], ",", 
          RowBox[{
           RowBox[{"Abs", "[", "x", "]"}], "<=", 
           SubscriptBox["x", "p"]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"vcr", "[", "x", "]"}], ",", 
          RowBox[{"x", ">", 
           SubscriptBox["x", "p"]}]}], "}"}]}], "}"}], "]"}], "/.", "repl"}], 
    "/.", "repl\[Omega]"}], "/.", "replAB"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"v", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{
      RowBox[{"-", 
       SubscriptBox["x", "c"]}], "/.", "repl"}], ",", 
     RowBox[{
      SubscriptBox["x", "c"], "/.", "repl"}]}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<v[x]\>\""}], "}"}]}]}], "]"}]}], "Input",
